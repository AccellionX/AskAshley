---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ashley Russo | Wealth Advisor for High-Net-Worth Individuals & Families',
  description =
    'Ashley Russo, wealth management advisor and founder of Russo Wealth Management, helps high-net-worth individuals, families, and tech professionals make confident wealth decisions.',
} = Astro.props;

const siteUrl = 'https://www.askashley.com';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ashley Russo',
  jobTitle: 'Wealth Management Advisor',
  worksFor: {
    '@type': 'Organization',
    name: 'Russo Wealth Management',
  },
  url: siteUrl,
  sameAs: ['https://www.linkedin.com/in/ashley-russo-nm/', '[YouTube channel URL placeholder]'],
  description,
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  name: 'Russo Wealth Management',
  url: siteUrl,
  description:
    'Wealth management guidance for high-net-worth individuals and families, including tech professionals and founders.',
  provider: {
    '@type': 'Person',
    name: 'Ashley Russo',
  },
  areaServed: 'US',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Ashley Russo" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-card focus:bg-navy focus:px-4 focus:py-3 focus:text-ivory"
    >
      Skip to content
    </a>
    <slot />
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduceMotion) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -32px 0px' }
        );

        document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll('.fade-in').forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
